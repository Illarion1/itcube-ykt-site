# Скопируйте этот файл в .env и впишите свои значения. Пустые строки можно не заполнять.

# Адрес сайта после публикации — для полных ссылок в превью соцсетей (Open Graph), например:
# VITE_SITE_URL=https://itcube-yakutsk.ru
VITE_SITE_URL=

# ---------- Сервер (npm start) ----------

# Порт, на котором работает сайт (по умолчанию 3000)
PORT=

# На каком адресе слушать. Если перед сайтом стоит Caddy или nginx на этом же сервере,
# впишите 127.0.0.1 — тогда напрямую, в обход прокси, сайт будет недоступен
HOST=

# Папка с данными сайта и загруженными файлами (по умолчанию data в папке проекта)
DATA_DIR=

# 1 — сайт открывают через Caddy или nginx (HTTPS). Тогда сервер доверяет их заголовкам
# с настоящим адресом посетителя и протоколом
TRUST_PROXY=

# Ключ для подписи входа в админ-панель. Можно не задавать: он создастся сам
# в data/private/session.key
SESSION_SECRET=
