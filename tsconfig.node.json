{
  // Проверка типов для серверной части (папка server) и настроек Vite.
  // Сервер запускается прямо из .ts-файлов: Node.js 22.18+ сам убирает из них типы,
  // поэтому здесь разрешены только «стираемые» конструкции TypeScript (без enum и т.п.).
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "types": ["node"],
    "skipLibCheck": true,
    "noEmit": true,

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["server", "vite.config.ts"]
}
